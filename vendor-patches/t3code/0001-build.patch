+        rustTarget: null,
+        cmake: `${cmake} -DGGML_CPU_ALL_VARIANTS=OFF -DCMAKE_PREFIX_PATH=${sdk}`,
+        rustflags: `${rustflags} -L native=${sdk}/Lib`,
+        features: "gpu",
