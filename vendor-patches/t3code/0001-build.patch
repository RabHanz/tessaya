+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const crate = path.join(input.repoRoot, "native/baton-dictation");
+  const destination = path.join(input.stageResourcesDir, "baton-voice");
+  yield* fs.remove(destination, { recursive: true, force: true }).pipe(Effect.ignore);
+  yield* fs.makeDirectory(destination, { recursive: true });
+  yield* fs.copy(path.join(crate, "models"), path.join(destination, "models"));
+  const exe = input.platform === "win" ? "tessaya-voice.exe" : "tessaya-voice";
+  const built: string[] = [];
+  const sdk = yield* Config.String("VULKAN_SDK").pipe(Config.withDefault(""));
+  const vulkanSdk = input.platform === "win" && sdk !== "" ? sdk : undefined;
+  const builds = batonSidecarBuild(input.platform, input.arch ?? "x64", vulkanSdk);
+  for (const build of builds) {
+    const spawnCommand = yield* resolveSpawnCommand("cargo", [
+      "build",
+      "--locked",
+      "--release",
+      ...(build.rustTarget === null ? [] : ["--target", build.rustTarget]),
+      ...(build.features === undefined ? [] : ["--features", build.features]),
+      "--manifest-path",
+      path.join(crate, "Cargo.toml"),
+    ]);
+    yield* runCommand(
+      ChildProcess.make(spawnCommand.command, spawnCommand.args, {
+        cwd: input.repoRoot,
+        shell: spawnCommand.shell,
+        env: {
+          ...process.env,
+          // A portable floor with AVX2: the runner's CPU may be newer than the user's.
+          TRANSCRIBE_CMAKE_ARGS: build.cmake,
+          ...(build.rustflags === undefined ? {} : { RUSTFLAGS: build.rustflags }),
+          ...(input.platform === "mac" ? { MACOSX_DEPLOYMENT_TARGET: "11.0" } : {}),
+        },
+      }),
+      {
+        label: `cargo build tessaya-voice${build.rustTarget === null ? "" : ` (${build.rustTarget})`}`,
+        verbose: input.verbose,
+      },
+    );
+    built.push(
+      path.join(
+        crate,
+        "target",
+        ...(build.rustTarget === null ? [] : [build.rustTarget]),
+        "release",
+        exe,
+      ),
+    );
+  }
+  const out = path.join(destination, exe);
+  if (built.length === 1) {
+    yield* fs.copyFile(built[0]!, out);
