+export function tessayaSidecarBuild(
+  platform: typeof BuildPlatform.Type,
+  arch: typeof BuildArch.Type,
+  vulkanSdk?: string,
+): ReadonlyArray<{
+  readonly rustTarget: string | null;
+  readonly cmake: string;
+  readonly rustflags?: string;
+  readonly features?: string;
