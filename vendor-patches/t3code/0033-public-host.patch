+/** Tessaya: this server's own name (a Tailscale Service now, a real domain later), advertised before the machine's. */
+export const publicBaseUrl = (host: string): string | null => {
+  const url = `https://${host.trim()}/`;
+  return host.trim().length > 0 && URL.canParse(url) ? new URL(url).toString() : null;
+};
+
+export const PublicBaseUrl = Config.String("TESSAYA_PUBLIC_HOST").pipe(
+  Config.withDefault(""),
+  Config.map(publicBaseUrl),
+);
+
+const DNS_LABEL = /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/;
+
+/** Tessaya: this machine's name under the one base domain, `<machine>.<domain>`; null when either is unusable. */
+export const publicDomainHost = (domain: string, machine: string): string | null => {
+  const label = machine.trim().toLowerCase().split(".")[0] ?? "";
+  const base = domain.trim().toLowerCase().replace(/^\.+|\.+$/g, "");
+  return DNS_LABEL.test(label) && base.split(".").length >= 2 && base.split(".").every((part) => DNS_LABEL.test(part))
+    ? `${label}.${base}`
+    : null;
+};
+
+/**
