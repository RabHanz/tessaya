#!/usr/bin/env bash
# tessaya-remote — attach to a Herdr session on another box (D70).
#
#   tessaya-remote <ssh-target> [session]     e.g.  tessaya-remote me@buildbox fab-api
#
# Herdr's --remote runs plain `ssh` with the user's SSH config. The box-to-box key is not in that
# config, so this puts an `ssh` shim first on PATH for this one command only: it adds the identity
# named by BATON_REMOTE_IDENTITY (default: the venture key) with IdentitiesOnly and BatchMode, and
# changes nothing else on the machine.
set -euo pipefail
# Settings are renamed TESSAYA_*; the old BATON_* names still work. Drop them once no unit or workflow sets them.
BATON_REMOTE_IDENTITY="${TESSAYA_REMOTE_IDENTITY:-${BATON_REMOTE_IDENTITY:-}}"
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/tessaya-env.sh" 2> /dev/null || true
target="${1:?usage: tessaya-remote <ssh-target> [session]}"
session="${2:-}"
identity="${BATON_REMOTE_IDENTITY:-${FAB_REMOTE_IDENTITY:-$HOME/.ssh/id_ed25519}}"
[[ -r "$identity" ]] || { echo "tessaya-remote: no identity at $identity (set BATON_REMOTE_IDENTITY)" >&2; exit 2; }
shim="$(mktemp -d "${TMPDIR:-/tmp}/tessaya-remote.XXXXXX")"
trap 'rm -rf "$shim"' EXIT
real_ssh="$(command -v ssh)"
printf '#!/bin/sh\nexec %q -i %q -o IdentitiesOnly=yes -o BatchMode=yes "$@"\n' "$real_ssh" "$identity" > "$shim/ssh"
chmod 700 "$shim/ssh"
args=(--remote "ssh://$target")
[[ -n "$session" ]] && args+=(--session "$session")
PATH="$shim:$PATH" herdr "${args[@]}"
