#!/usr/bin/env bash
# tessaya — start (or rejoin) work inside Tessaya + Herdr, so a session is owned from birth (D68).
#
#   tessaya <project|dir> [claude|codex|<command…>]   new agent in a new tab of that project's space
#   tessaya --resume <claude-session-id> [dir]          bring an existing Claude conversation into Herdr
#   tessaya resume <thread> [--force]                   a Tessaya thread's session in Herdr, on the thread's own login;
#                                                       works with the server down (reads tessaya-sessions.json)
#   tessaya                                             attach to the space for the current directory
#
# Every agent started this way lives in a Herdr session named fab-<project>: it survives the
# terminal, T3 and ssh going away, appears in the Tessaya fleet on every device, and takes input
# from the fleet's send field. Nothing here touches an account; rotation happens underneath.
set -euo pipefail
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/lib/tessaya-env.sh" 2> /dev/null || true

roots=(${BATON_ROOTS:-${FAB_ROOTS:-"$PWD" "$HOME" "$HOME/dev"}})

# `resume <thread>`: the thread's session id, login and folder come from the file the server keeps, never its database.
from_thread=0
force=0
if [[ "${1:-}" == "resume" ]]; then
  [[ -n "${2:-}" ]] || { echo "usage: tessaya resume <thread id, session id or title words> [--force]" >&2; exit 2; }
  [[ "${3:-}" == "--force" ]] && force=1
  file="${TESSAYA_SESSIONS_FILE:-${T3CODE_HOME:-$HOME/.t3}/userdata/tessaya-sessions.json}"
  [[ -f "$file" ]] || { echo "tessaya: $file is missing (Tessaya's server writes it)" >&2; exit 2; }
  found="$(python3 -I - "$file" "$2" << 'PY'
import json, sys
threads = json.load(open(sys.argv[1])).get("threads", [])
want = sys.argv[2]
hits = (
    [t for t in threads if want in (t["threadId"], t["sessionId"])]
    or [t for t in threads if t["threadId"].startswith(want) or t["sessionId"].startswith(want)]
    or [t for t in threads if want.lower() in t.get("title", "").lower()]
)
if len(hits) != 1:
    print(f"tessaya: {len(hits)} threads match '{want}'", file=sys.stderr)
    for t in hits[:10]:
        print(f"  {t['threadId']}  {t.get('title', '')}", file=sys.stderr)
    sys.exit(1)
print(hits[0]["sessionId"], hits[0]["configDir"], hits[0]["cwd"], sep="\t")
PY
  )" || exit 1
  IFS=$'\t' read -r thread_session thread_config thread_cwd <<< "$found"
  export TESSAYA_RESUME_CONFIG_DIR="$thread_config"
  from_thread=1
  set -- --resume "$thread_session" "$thread_cwd"
fi

resolve_dir() {
  local want="$1"
  if [[ -d "$want" ]]; then (cd "$want" && pwd); return; fi
  for root in "${roots[@]}"; do
    [[ -d "$root/$want" ]] && { (cd "$root/$want" && pwd); return; }
  done
  echo "tessaya: no directory named '$want' under ${roots[*]}" >&2
  exit 2
}

# Each conversation in its own config dir, so its login can move while it runs (LIVE-ACCOUNT).
claude_cmd=claude
command -v tessaya-claude > /dev/null 2>&1 && claude_cmd=tessaya-claude
agent=()
if [[ "${1:-}" == "--resume" ]]; then
  [[ -n "${2:-}" ]] || { echo "usage: tessaya --resume <session-id> [dir]" >&2; exit 2; }
  dir="$(resolve_dir "${3:-$PWD}")"
  agent=("$claude_cmd" --resume "$2")
elif [[ $# -eq 0 ]]; then
  dir="$PWD"
else
  dir="$(resolve_dir "$1")"
  shift
  case "${1:-claude}" in
    claude) agent=("$claude_cmd") ;;
    codex) agent=(codex) ;;
    *) agent=("$@") ;;
  esac
fi

# Legacy name: the `fab-` session prefix is kept so `baton` rejoins spaces `fab` started (D71).
name="fab-$(basename "$dir" | tr -c 'A-Za-z0-9_\n-' '-')"
running() { herdr session list 2>/dev/null | awk -v n="$name" '$1 == n && $2 == "running" { found = 1 } END { exit !found }'; }

# A live Claude process already holds this conversation (any account's sessions folder).
holder() {
  local f
  for f in "$HOME"/.claude/sessions/*.json "$HOME"/.claude-*/sessions/*.json \
    "$HOME"/.local/share/claude-swap/sessions/*/sessions/*.json \
    "${TESSAYA_CLAUDE_THREADS:-$HOME/.local/share/tessaya/claude-threads}"/*/sessions/*.json \
    "${TESSAYA_RESUME_CONFIG_DIR:-/nonexistent}"/sessions/*.json; do
    [[ -f "$f" ]] && grep -q "\"sessionId\":\"$1\"" "$f" && kill -0 "$(basename "$f" .json)" 2> /dev/null &&
      holder_pid="$(basename "$f" .json)" && holder_file="$f" && return 0
  done
  return 1
}
# The success line callers parse ("running in <space> pane <pane>"), from the holder's Herdr variables.
say_where() {
  local env space pane
  env="$(tr '\0' '\n' < "/proc/$holder_pid/environ" 2> /dev/null || true)"
  space="$(sed -n 's/^HERDR_SESSION=//p' <<< "$env")"
  pane="$(sed -n 's/^HERDR_PANE_ID=//p' <<< "$env")"
  if [[ -n "$pane" ]]; then
    echo "tessaya: claude running in ${space:-default} pane $pane"
  else
    echo "tessaya: ${agent[2]} is running outside Herdr (pid $holder_pid)"
  fi
}
wait_holder() { for _ in $(seq 1 60); do holder "$1" && return 0; sleep 0.5; done; return 1; }
herdr_dir="$HOME/.config/herdr/sessions/$name"

# A resume never makes a twin: not while the conversation runs, not twice at once, and not when
# starting the space's server restores a pane that already resumes it.
restored=0
if ((${#agent[@]} > 0)) && [[ "${agent[1]:-}" == "--resume" ]]; then
  exec 9> "${XDG_RUNTIME_DIR:-/tmp}/tessaya-resume-${agent[2]}.lock"
  flock -w 60 9 || { echo "tessaya: another resume of ${agent[2]} is still starting" >&2; exit 1; }
  # Tessaya's own SDK process holds a thread's session: stop it only when asked (--force), never two writers.
  if ((from_thread)) && holder "${agent[2]}" && grep -q '"entrypoint":"sdk' "$holder_file"; then
    if ((!force)); then
      echo "tessaya: Tessaya is hosting this session (pid $holder_pid). Use Open in terminal in Tessaya, or add --force to stop it here." >&2
      exit 1
    fi
    kill -TERM "$holder_pid" 2> /dev/null || true
    for _ in $(seq 1 60); do kill -0 "$holder_pid" 2> /dev/null || break; sleep 0.25; done
    kill -0 "$holder_pid" 2> /dev/null && { echo "tessaya: pid $holder_pid did not stop" >&2; exit 1; }
  fi
  if holder "${agent[2]}"; then
    say_where
    agent=()
  elif ! running && grep -q "\"value\": *\"${agent[2]}\"" "$herdr_dir/session.json" 2> /dev/null; then
    restored=1
  fi
fi

# The session's server runs headless and outlives this shell, so a plain attach (VS Code's
# terminal) never hosts it: closing the terminal leaves every agent in the space running.
if ! running; then
  # Under systemd when the box has the herdr-session@ unit, so the space comes back after a reboot or a kill.
  if [[ -z "${TESSAYA_NO_SYSTEMD:-}" ]] && systemctl --user cat herdr-session@.service > /dev/null 2>&1; then
    systemctl --user enable --now "herdr-session@$name" > /dev/null 2>&1 ||
      (cd "$dir" && setsid herdr --session "$name" server < /dev/null > /dev/null 2>&1 &)
  else
    (cd "$dir" && setsid herdr --session "$name" server < /dev/null > /dev/null 2>&1 &)
  fi
  for _ in $(seq 1 50); do running && break; sleep 0.2; done
fi

if ((restored)); then
  # Herdr's restore brings the pane back; hold the lock until it is running so a second caller sees it.
  if wait_holder "${agent[2]}"; then say_where; else echo "tessaya: $name restored but ${agent[2]} did not start" >&2; fi
elif ((${#agent[@]} > 0)); then
  cmd="$(printf '%q ' "${agent[@]}")"
  # The pane's shell starts from Herdr's environment, so a thread's login goes in the command itself.
  [[ -n "${TESSAYA_RESUME_CONFIG_DIR:-}" ]] && cmd="CLAUDE_CONFIG_DIR=$(printf '%q' "$TESSAYA_RESUME_CONFIG_DIR") $cmd"
  if herdr --session "$name" workspace list 2>/dev/null | grep -q '"workspace_id"'; then
    herdr --session "$name" tab create --cwd "$dir" --label "${agent[0]#tessaya-}" --focus >/dev/null
  else
    herdr --session "$name" workspace create --cwd "$dir" --label "$(basename "$dir")" --focus >/dev/null
  fi
  # The newest pane is the one just created.
  pane="$(herdr --session "$name" pane list | grep -o '"pane_id":"[^"]*"' | tail -1 | cut -d'"' -f4)"
  herdr --session "$name" pane run "$pane" "$cmd" >/dev/null
  echo "tessaya: ${agent[0]#tessaya-} running in $name pane $pane"
  [[ "${agent[1]:-}" == "--resume" ]] && { wait_holder "${agent[2]}" || true; }
fi

if [[ -t 1 ]]; then
  cd "$dir"
  exec herdr --session "$name"
fi
echo "tessaya: $name ready in $dir (attach with: herdr --session $name)"
