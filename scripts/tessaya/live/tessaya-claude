#!/usr/bin/env bash
# Claude Code with its own config dir per conversation (LIVE-ACCOUNT), so one live thread can move to another account
# while it runs: Claude re-reads $CLAUDE_CONFIG_DIR/.credentials.json when its mtime changes, sub-agents included.
#
#   tessaya-claude [claude args…]          new session: a fresh dir seeded from the machine's login
#   tessaya-claude --resume <id> […]       the dir that last hosted <id>, else a fresh one
#   tessaya-claude --dir [--resume <id>]   print the dir it would use (seeding it), run nothing
#   tessaya-claude --switch <dir> <slot>   put cswap slot <slot>'s credential into <dir> (atomic rename)
#
# Everything in ~/.claude is shared by link (projects, history, settings, skills…) except the credential, the live
# session descriptors and the global config, which Claude rewrites in place. A login with a refresh token is never
# copied: Claude rotates it in place, so two copies would strand each other (cswap's own rule); such a machine login
# runs plain `claude`, and a refreshable slot moves to at most one dir at a time.
set -euo pipefail

root="${TESSAYA_CLAUDE_THREADS:-$HOME/.local/share/tessaya/claude-threads}"
# The login to start from: the machine's, or the profile a caller such as `cswap run` chose.
home_cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
global_cfg="$HOME/.claude.json"
[[ "$home_cfg" == "$HOME/.claude" ]] || global_cfg="$home_cfg/.claude.json"
swap="${CSWAP_DATA:-$HOME/.local/share/claude-swap}"

refreshable() { grep -q '"refreshToken"' "$1" 2> /dev/null; }
active_slot() {
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("activeAccountNumber") or "")' \
    "$swap/sequence.json" 2> /dev/null || true
}

seed() {
  local dir="$1" entry name
  mkdir -p "$dir/sessions"
  chmod 700 "$dir"
  for entry in "$home_cfg"/* "$home_cfg"/.[!.]*; do
    name="$(basename "$entry")"
    case "$name" in .credentials.json | sessions | .claude.json | .claude.json.lock | '.[!.]*' | '*') continue ;; esac
    [[ -e "$dir/$name" || -L "$dir/$name" ]] || ln -s "$entry" "$dir/$name"
  done
  [[ -f "$dir/.claude.json" || ! -f "$global_cfg" ]] || cp "$global_cfg" "$dir/.claude.json"
  if [[ ! -f "$dir/.credentials.json" ]]; then
    local tmp
    tmp="$(mktemp "$dir/.cred.XXXXXX")"
    cp "$home_cfg/.credentials.json" "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$dir/.credentials.json"
    # The slot is known only for the machine's login; a cswap profile's is read from its config by the server.
    if [[ "$home_cfg" == "$HOME/.claude" ]]; then active_slot > "$dir/.tessaya-account"; else : > "$dir/.tessaya-account"; fi
  fi
}

# The dir for this launch, or nothing when the machine's login cannot be copied.
pick_dir() {
  local resume="$1" dir
  [[ -f "$home_cfg/.credentials.json" ]] && ! refreshable "$home_cfg/.credentials.json" || return 0
  if [[ -n "$resume" && -d "$root/s-$resume" ]]; then
    dir="$(readlink -f "$root/s-$resume")"
  elif [[ -n "$resume" ]]; then
    dir="$root/s-$resume"
  else
    dir="$root/n-$(date +%s)-$$"
  fi
  seed "$dir"
  echo "$dir"
}

if [[ "${1:-}" == "--switch" ]]; then
  dir="${2:?--switch <dir> <slot>}"
  slot="${3:?--switch <dir> <slot>}"
  [[ "$slot" =~ ^[0-9]{1,4}$ ]] || { echo "not a slot: $slot" >&2; exit 2; }
  [[ "$(readlink -f "$dir")" == "$(readlink -f "$root")"/* && -f "$dir/.tessaya-account" ]] ||
    { echo "not a Tessaya thread dir: $dir" >&2; exit 2; }
  py="$(head -1 "$(command -v cswap)" | sed 's/^#!//')"
  exec "$py" -I - "$swap" "$root" "$dir" "$slot" << 'PY'
import json, os, sys, tempfile
from claude_swap.switcher import ClaudeAccountSwitcher

swap, root, target_dir, slot = sys.argv[1:]
seq = json.load(open(os.path.join(swap, "sequence.json")))
accounts = seq["accounts"]
if slot not in accounts:
    sys.exit(f"no account in slot {slot}")
sw = ClaudeAccountSwitcher()
cred_path = os.path.join(target_dir, ".credentials.json")
marker = os.path.join(target_dir, ".tessaya-account")
current = open(marker).read().strip()
refreshable = lambda text: '"refreshToken"' in text
# A refreshable login lives in one place: hand the rotated copy back before leaving it.
if current in accounts and current != slot and os.path.exists(cred_path):
    held = open(cred_path).read()
    if refreshable(held):
        sw._write_account_credentials(current, accounts[current]["email"], held)
creds = sw._read_account_credentials(slot, accounts[slot]["email"])
if refreshable(creds):
    if slot == str(seq.get("activeAccountNumber")):
        sys.exit("that login is the machine's own and refreshes in place; it cannot be copied to one thread")
    for name in os.listdir(root):
        other = os.path.join(root, name, ".tessaya-account")
        if os.path.realpath(os.path.dirname(other)) != os.path.realpath(target_dir) and os.path.exists(other) \
                and open(other).read().strip() == slot:
            sys.exit("that login refreshes in place and another thread holds it")
fd, tmp = tempfile.mkstemp(dir=target_dir, prefix=".cred.")
os.write(fd, creds.encode()); os.close(fd); os.chmod(tmp, 0o600)
os.replace(tmp, cred_path)
fd, tmp = tempfile.mkstemp(dir=target_dir, prefix=".acct.")
os.write(fd, slot.encode()); os.close(fd)
os.replace(tmp, marker)
print(f"slot {slot}")
PY
fi

if [[ "${1:-}" == "--dir" ]]; then
  if [[ "${2:-}" == "--resume" ]]; then pick_dir "${3:-}"; else pick_dir ""; fi
  exit 0
fi

resume=""
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  [[ "${args[i]}" == "--resume" || "${args[i]}" == "-r" ]] && resume="${args[i + 1]:-}"
done
self="$(readlink -f "$0")"
real="${TESSAYA_REAL_CLAUDE:-}"
if [[ -z "$real" ]]; then
  while read -r candidate; do
    [[ "$(readlink -f "$candidate")" == "$self" ]] || { real="$candidate"; break; }
  done < <(type -P -a claude)
fi
[[ -n "$real" ]] || { echo "tessaya-claude: no claude on PATH" >&2; exit 127; }
# Already in a thread's own dir (a hook or tool starting claude inside one): leave it there.
[[ "$(readlink -f "${CLAUDE_CONFIG_DIR:-/}")" != "$(readlink -f "$root")"/* ]] || exec "$real" "$@"
dir="$(pick_dir "$resume")"
[[ -n "$dir" ]] || exec "$real" "$@"
exec env -u CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CONFIG_DIR="$dir" "$real" "$@"
