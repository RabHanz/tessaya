# Where things are. Secrets live in 0600 files named here, never in this file.
R1_MODELS=/home/<user>/r1-voice/models
R1_STATE=/home/<user>/r1-voice/state
R1_POCKET_BIN=/home/<user>/r1-voice/models/pocket/pocket-tts-3.3.0-x86_64-unknown-linux-gnu/pocket-tts
R1_VOICE=anna
R1_TTS_THREADS=2
R1_ONNX_THREADS=2
# The broker the R1 uses (over the tailnet) and the room loop's own MQTT user.
R1_MQTT_HOST=<broker tailnet address>
R1_MQTT_PORT=1883
R1_MQTT_USER=voice
R1_MQTT_PASS_FILE=/home/<user>/r1-voice/secrets/mqtt-pass
# Or the server's own device hub, with its bus login (user tessaya-bus, the key from Settings): this wins over host and port.
# R1_MQTT_URL=ws://127.0.0.1:3773/api/r1/mqtt
# His recognisers (the dictation service), url=token-file, comma-separated: each turn goes to the quickest lately.
R1_RECOGNIZERS=ws://<this host>:8797=/home/<user>/tsy-recognizer/token,ws://<second host>:8797=/home/<user>/r1-voice/secrets/recognizer-second-token
# Her room turn on the server.
R1_BRAIN_URL=https://tessaya.example/api/devices/r1/v1/chat/completions
R1_DEVICE_KEY_FILE=/home/<user>/r1-voice/secrets/device-key
# R1s switched to this loop (comma-separated device ids). Empty: none; the replay pretend-R1 needs no switch.
R1_INHOUSE=
# R1_CAMERA_PORT=5090
