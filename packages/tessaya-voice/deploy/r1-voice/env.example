# Where things are. Secrets live in 0600 files named here, never in this file.
TESSEL_MODELS=/home/<user>/r1-voice/models
TESSEL_STATE=/home/<user>/r1-voice/state
TESSEL_POCKET_BIN=/home/<user>/r1-voice/models/pocket/pocket-tts-3.3.0-x86_64-unknown-linux-gnu/pocket-tts
TESSEL_VOICE=anna
TESSEL_TTS_THREADS=2
TESSEL_ONNX_THREADS=2
# The broker the R1 uses (over the tailnet) and the room loop's own MQTT user.
TESSEL_MQTT_HOST=<broker tailnet address>
TESSEL_MQTT_PORT=1883
TESSEL_MQTT_USER=voice
TESSEL_MQTT_PASS_FILE=/home/<user>/r1-voice/secrets/mqtt-pass
# Or the server's own device hub, with its bus login (user tessaya-bus, the key from Settings): this wins over host and port.
# TESSEL_MQTT_URL=ws://127.0.0.1:3773/api/tessel/mqtt (or mqtt://127.0.0.1:1884 when the server sets TESSAYA_TESSEL_MQTT_TCP)
# His recognisers (the dictation service), url=token-file, comma-separated: each turn goes to the quickest lately.
TESSEL_RECOGNIZERS=ws://<this host>:8797=/home/<user>/tsy-recognizer/token,ws://<second host>:8797=/home/<user>/r1-voice/secrets/recognizer-second-token
# Her room turn on the server.
TESSEL_BRAIN_URL=https://tessaya.example/api/devices/tessel/v1/chat/completions
TESSEL_DEVICE_KEY_FILE=/home/<user>/r1-voice/secrets/device-key
# R1s switched to this loop (comma-separated device ids). Empty: none; the replay pretend-R1 needs no switch.
TESSEL_INHOUSE=
# TESSEL_CAMERA_PORT=5090
# Keep every wake segment for wake training (room audio: only with consent). Unset: off.
# TESSEL_WAKE_CAPTURE_DIR=/home/<user>/r1-voice/wakecap
# TESSEL_WAKE_CAPTURE_MB=1024
