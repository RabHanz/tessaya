diff --git a/dist/cjs/index.js b/dist/cjs/index.js
index f5f8a83..8ad870b 100644
--- a/dist/cjs/index.js
+++ b/dist/cjs/index.js
@@ -6,7 +6,9 @@ let node_crypto = require("node:crypto");
 //#region src/main/validate-sender.ts
 function isMainFrameEvent(event) {
 	const { sender, senderFrame } = event;
-	return sender.getType() === "window" && Boolean(senderFrame) && senderFrame === sender.mainFrame;
+	// t3code patch: a <webview> guest counts only when the host registered it as trusted (its id and main frame).
+	const trustedGuest = sender.getType() === "webview" && globalThis[Symbol.for("t3code.clerk.isTrustedGuest")]?.(event) === true;
+	return (sender.getType() === "window" || trustedGuest) && Boolean(senderFrame) && senderFrame === sender.mainFrame;
 }
 
 //#endregion
